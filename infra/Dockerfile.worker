FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scanner /scanner
COPY apps/api /app/apps/api

RUN groupadd -r scanly && useradd -r -g scanly -d /app -s /sbin/nologin scanly \
    && mkdir -p /storage/reports /app/secrets \
    && chown -R scanly:scanly /app /scanner /storage/reports

USER scanly

ENV PYTHONPATH="/app/apps/api:/scanner:${PYTHONPATH}"

CMD ["celery", "-A", "app.tasks.celery_app.celery_app", "worker", "--loglevel=info", "-c", "2"]

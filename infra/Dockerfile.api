FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY scanner /scanner
COPY apps/api /app/apps/api

RUN groupadd -r scanly && useradd -r -g scanly -d /app -s /sbin/nologin scanly \
    && mkdir -p /storage/reports /app/secrets \
    && chown -R scanly:scanly /app /scanner /storage/reports

USER scanly

ENV PYTHONPATH="/app/apps/api:/scanner:${PYTHONPATH}"

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--app-dir", "apps/api", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]

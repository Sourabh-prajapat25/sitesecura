# Scanly API - Environment Variables Example
ENVIRONMENT=development
APP_NAME=Scanly
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SECRET_KEY=development-secret-key-scanly-replace-in-production

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://scanly:scanly_dev_password@localhost:5432/scanly
DATABASE_URL_SYNC=postgresql://scanly:scanly_dev_password@localhost:5432/scanly

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Firebase Authentication (Project: scanly-user)
FIREBASE_PROJECT_ID=scanly-user
FIREBASE_AUTH_DOMAIN=scanly-user.firebaseapp.com
# For local dev with Google Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or specify service account credentials directly in environment:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@scanly-user.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Scanner
SCANNER_MODE=real
SCANNER_TIMEOUT_SECONDS=10.0
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576

# Storage
STORAGE_PATH=./storage/reports

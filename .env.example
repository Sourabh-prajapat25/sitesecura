# ==============================================================================
# SCANLY ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the secrets for production/development.
# ==============================================================================

# General Application Settings
ENVIRONMENT=development
APP_NAME=Scanly
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scanly
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/scanly

# Redis & Celery Background Queue
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scanner Settings
SCANNER_MODE=real
SCANNER_TIMEOUT_SECONDS=10
SCANNER_CONNECT_TIMEOUT=5.0
SCANNER_READ_TIMEOUT=5.0
SCANNER_WRITE_TIMEOUT=5.0
SCANNER_POOL_TIMEOUT=5.0
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576
ENABLE_NMAP=false

# Firebase Authentication (Server Side)
FIREBASE_PROJECT_ID=scanly-user
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@scanly-user.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=""

# Firebase Authentication (Client Side - Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDD3lPxjO5RVgtA3i9Tr2TSkPTp9GxPKC8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=scanly-user.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=scanly-user
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=scanly-user.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=139878140836
NEXT_PUBLIC_FIREBASE_APP_ID=1:139878140836:web:92c46b91234795db9d8f31

# Payment Gateways & Routing
DEFAULT_PAYMENT_PROVIDER=razorpay
ENABLE_STRIPE=true
ENABLE_RAZORPAY=true

# Stripe Payments & Billing
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret
STRIPE_BASIC_PRICE_ID=price_basic_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_AGENCY_PRICE_ID=price_agency_monthly
STRIPE_PRICE_BASIC_YEARLY=price_basic_yearly
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly
STRIPE_PRICE_AGENCY_YEARLY=price_agency_yearly

# Razorpay Payments & Billing (India Launch)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder_secret
RAZORPAY_PLAN_BASIC_MONTHLY=plan_basic_monthly_inr
RAZORPAY_PLAN_BASIC_YEARLY=plan_basic_yearly_inr
RAZORPAY_PLAN_PRO_MONTHLY=plan_pro_monthly_inr
RAZORPAY_PLAN_PRO_YEARLY=plan_pro_yearly_inr
RAZORPAY_PLAN_AGENCY_MONTHLY=plan_agency_monthly_inr
RAZORPAY_PLAN_AGENCY_YEARLY=plan_agency_yearly_inr

# Transactional Email Service (Resend Production Delivery)
RESEND_API_KEY=re_your_api_key_here
RESEND_API_BASE_URL=https://api.resend.com/emails
RESEND_WEBHOOK_SECRET=whsec_placeholder_secret
EMAIL_FROM="SiteSecura Security <alerts@sitesecura.com>"
EMAIL_FROM_NAME="SiteSecura Security"
EMAIL_REPLY_TO="support@sitesecura.com"

# Delivery Reliability & Timeouts
EMAIL_TIMEOUT_SECONDS=10.0
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=2.0

# Storage Settings
STORAGE_PATH=/storage/reports

# ==============================================================================
# AI SECURITY ADVISOR (PRO & AGENCY)
# Multi-provider orchestration: Groq Primary -> Groq Fallback -> Gemini Fallback
# ==============================================================================
AI_ENABLED=true
AI_PRIMARY_PROVIDER=groq1
AI_PROVIDER_ORDER=groq1,groq2,gemini
AI_ENABLE_FALLBACK=true
AI_LOG_PROVIDER_USAGE=true

# Groq Primary Provider
GROQ1_API_KEY=gsk_placeholder_primary_key
GROQ1_MODEL=llama-3.3-70b-versatile

# Groq Fallback Provider
GROQ2_API_KEY=gsk_placeholder_secondary_key
GROQ2_MODEL=llama-3.1-8b-instant

# Gemini Fallback Provider
GEMINI_API_KEY=AIzaSy_placeholder_gemini_key
GEMINI_MODEL=gemini-1.5-flash

# AI Limits & Controls
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2000
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=1
AI_MAX_CONTEXT_CHARS=16000
AI_SYSTEM_PROMPT_VERSION=v1
AI_RATE_LIMIT_PER_USER=20
AI_MONTHLY_LIMIT_PRO=100
AI_MONTHLY_LIMIT_AGENCY=500

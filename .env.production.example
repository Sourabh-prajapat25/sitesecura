# ==============================================================================
# SITESECURA PRODUCTION ENVIRONMENT TEMPLATE (.env.production)
# Copy this file to .env.production or .env on the production VPS.
# Fill in real production credentials. NEVER COMMIT THIS FILE WITH REAL SECRETS.
# ==============================================================================

# Core Runtime Environment
ENVIRONMENT=production
APP_NAME=SiteSecura
NEXT_PUBLIC_APP_URL=https://sitesecura.com
API_URL=https://sitesecura.com/api
ALLOWED_ORIGINS=https://sitesecura.com

# Cryptographic Secret (Must be >= 32 characters; generate with: openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_HEX_64_CHAR_SECRET_KEY_NEVER_USE_DEFAULT
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database (Internal Docker network service: postgres:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD
POSTGRES_DB=scanly
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/scanly
DATABASE_URL_SYNC=postgresql://postgres:REPLACE_WITH_STRONG_RANDOM_POSTGRES_PASSWORD@postgres:5432/scanly

# Redis & Celery Background Queue (Internal Docker network service: redis:6379)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Rate Limiting Fallback Policy (false: bounded in-memory with critical logs, true: fail-closed 503)
REDIS_RATE_LIMIT_FAIL_CLOSED=false

# Scanner Settings & Safeguards
SCANNER_MODE=real
SCANNER_TIMEOUT_SECONDS=10
SCANNER_CONNECT_TIMEOUT=5.0
SCANNER_READ_TIMEOUT=5.0
SCANNER_WRITE_TIMEOUT=5.0
SCANNER_POOL_TIMEOUT=5.0
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576
ENABLE_NMAP=false

# Server-Side Firebase Admin Authentication
FIREBASE_PROJECT_ID=sitesecura-prod
# Option A: Mount service account file into /app/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
# Option B: Or provide credentials via environment variables:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@sitesecura-prod.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# Client-Side Firebase Configuration (Next.js public build/runtime)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_PRODUCTION_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sitesecura-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sitesecura-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sitesecura-prod.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:YOUR_SENDER_ID:web:YOUR_APP_ID
NEXT_PUBLIC_API_URL=/api/v1

# Transactional Email (Resend Production Delivery)
RESEND_API_KEY=re_LIVE_PRODUCTION_KEY_NEVER_USE_PLACEHOLDER
RESEND_API_BASE_URL=https://api.resend.com/emails
RESEND_WEBHOOK_SECRET=whsec_placeholder_secret
EMAIL_FROM="SiteSecura Security <alerts@sitesecura.com>"
EMAIL_FROM_NAME="SiteSecura Security"
EMAIL_REPLY_TO="support@sitesecura.com"

# Storage Settings (Mounted to persistent Docker volume)
STORAGE_PATH=/storage/reports

# Billing Gateways (STATUS: LIVE PAYMENT DEFERRED)
DEFAULT_PAYMENT_PROVIDER=stripe
ENABLE_STRIPE=false
ENABLE_RAZORPAY=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_AGENCY_YEARLY=

# AI Security Advisor (Optional/Deferred)
AI_ENABLED=false
AI_PRIMARY_PROVIDER=groq1
AI_PROVIDER_ORDER=groq1,groq2,gemini
AI_ENABLE_FALLBACK=true
AI_LOG_PROVIDER_USAGE=true
GROQ1_API_KEY=
GROQ2_API_KEY=
GEMINI_API_KEY=
